# Appraisal Commons needs one key. The app looks for .env in this folder first,
# then in the folder above it.
PORTKEY_API_KEY=

# Optional (defaults shown)
# DESK_PASSCODE=                   # review desk passcode; unset = demo passcode 'desk-demo', localhost only
# SESSION_SECRET=                  # signs session cookies; unset = random per server start
# SESSION_BUDGET_USD=0.25
# DAILY_BUDGET_USD=2.00
# AI_PAUSED=1                      # kill switch: turns off every AI feature, records still work
